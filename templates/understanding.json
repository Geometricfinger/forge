    "id": "forge-self-understanding",
    "title": "Find understanding implementation clues for FORGE",
    "targets": [
      {
        "api": "ast.parse",
        "capability": "python_syntax_tree"
      },
      {
        "api": "ast.walk",
        "capability": "syntax_tree_traversal"
      },
      {
        "api": "symtable.symtable",
        "capability": "compiler_scope_table"
      },
      {
        "api": "libcst.parse_module",
